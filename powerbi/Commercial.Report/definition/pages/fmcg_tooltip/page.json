{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "fmcg_tooltip",
  "displayName": "Tooltip detail",
  "displayOption": "FitToPage",
  "width": 600,
  "height": 360,
  "type": "Tooltip",
  "visibility": "HiddenInViewMode",
  "pageBinding": {
    "name": "fmcg_tooltip_binding",
    "type": "Tooltip",
    "parameters": [
      {
        "name": "fmcg_tooltip_context",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimProduct"
              }
            },
            "Property": "Product"
          }
        },
        "boundFilter": "fmcg_tooltip_filter"
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "fmcg_tooltip_filter",
        "type": "Categorical",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "DimProduct"
              }
            },
            "Property": "Product"
          }
        },
        "howCreated": "User"
      }
    ]
  },
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F3F5F7'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  }
}
