        "partitions": [
          {
            "name": "DimProduct",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Base = fnLoadCsv(\"fmcg/DimProduct.csv\",{{\"ProductKey\",Int64.Type},{\"Product\",type text},{\"Brand\",type text},{\"CategoryKey\",Int64.Type},{\"Category\",type text},{\"PackMl\",Int64.Type},{\"Innovation\",Int64.Type},{\"LaunchDate\",type date},{\"RegularPrice\",type number},{\"UnitCost\",type number},{\"DataClass\",type text}},{\"ProductKey\"},{},{\"SYNTHETIC\"}),\n    Joined = Table.NestedJoin(Base,{\"CategoryKey\"},DimCategory,{\"CategoryKey\"},\"CategoryMap\",JoinKind.LeftOuter),\n    BadMappings = Table.SelectRows(Joined,each Table.RowCount([CategoryMap])<>1),\n    Checked = if Table.RowCount(BadMappings)>0 then error \"Invalid category mapping\" else Joined,\n    NoOldCategory = Table.RemoveColumns(Checked,{\"Category\"}),\n    Result = Table.ExpandTableColumn(NoOldCategory,\"CategoryMap\",{\"Category\"},{\"Category\"})\nin Result"
            }
          }
        ],
        "annotations": [
          {
            "name": "DataProvenance",
            "value": "SYNTHETIC"
          }
        ],
