        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM(FactSales[Revenue])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "01 Performance",
            "description": "Synthetic AUD ex GST net revenue; trade spend is accounted separately.",
            "lineageTag": "7529e08d-010e-51c7-9fbd-398ca0b52919"
          },
          {
            "name": "Units",
            "expression": "SUM(FactSales[Units])",
            "formatString": "#,0",
            "displayFolder": "01 Performance",
            "description": "Individual packs sold, not unit cases.",
            "lineageTag": "9aeaadf1-46dd-53b7-b28f-35b247adb55a"
          },
          {
            "name": "Volume Litres",
            "expression": "SUM(FactSales[VolumeLitres])",
            "formatString": "#,0",
            "displayFolder": "01 Performance",
            "description": "Units times pack millilitres / 1000.",
            "lineageTag": "8451d43f-f6d7-5646-85df-1a4f7ea34ff3"
          },
          {
            "name": "COGS",
            "expression": "SUM(FactSales[COGS])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "01 Performance",
            "description": "Simulated variable product cost, excluding trade spend.",
            "lineageTag": "f8493c72-223a-59e4-ba50-ae6ccd143070"
          },
          {
            "name": "Gross Profit",
            "expression": "[Revenue] - [COGS]",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "01 Performance",
            "description": "Before trade spend and overheads.",
            "lineageTag": "bdb9205c-5234-582c-85ac-24077bbbfd49"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE([Gross Profit],[Revenue])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "01 Performance",
            "description": "Ratio of totals, never an average of row percentages.",
            "lineageTag": "b6ffdf16-e6ea-59c4-96f9-00a37733e863"
          },
          {
            "name": "Average Selling Price",
            "expression": "DIVIDE([Revenue],[Units])",
            "formatString": "$0.00",
            "displayFolder": "01 Performance",
            "description": "AUD per pack. Mix effects mean it is not a pure price index.",
            "lineageTag": "f456430d-6b60-5854-9771-7ba22063c1c9"
          },
          {
            "name": "Revenue LY",
            "expression": "CALCULATE([Revenue], SAMEPERIODLASTYEAR(DimDate[Date]))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "02 Time",
            "description": "Same calendar dates one year earlier; first-year comparison is blank.",
            "lineageTag": "e7c49ec3-7d96-53af-a5f3-6e39daa57ef0"
          },
          {
            "name": "Revenue YoY %",
            "expression": "IF(HASONEVALUE(DimDate[Year]),DIVIDE([Revenue] - [Revenue LY],[Revenue LY]))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "02 Time",
            "description": "Growth relative to matching prior-year revenue; blank unless one calendar year is selected.",
            "lineageTag": "1c197425-7e78-53c1-9359-b7b45c829a04"
          },
          {
            "name": "Revenue YTD",
            "expression": "CALCULATE([Revenue], DATESYTD(DimDate[Date]))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "02 Time",
            "description": "Calendar-year cumulative revenue.",
            "lineageTag": "406b9e77-4d82-57ac-ba14-b39958641608"
          },
          {
            "name": "Volume LY",
            "expression": "CALCULATE([Volume Litres], DATEADD(DimDate[Date],-1,YEAR))",
            "formatString": "#,0",
            "displayFolder": "02 Time",
            "description": "Calendar-aligned prior-year volume.",
            "lineageTag": "3e738971-6ef2-5073-b33b-1b8bea0786d4"
          },
          {
            "name": "Volume Growth %",
            "expression": "IF(HASONEVALUE(DimDate[Year]),DIVIDE([Volume Litres]-[Volume LY],[Volume LY]))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "02 Time",
            "description": "Litres growth; blank unless one calendar year is selected.",
            "lineageTag": "73dbd283-09ee-5d68-8eed-6805d2a98dcc"
          },
          {
            "name": "Rolling 4 Week Sales",
            "expression": "VAR EndDate = MAX(DimDate[Date]) RETURN CALCULATE([Revenue],DATESINPERIOD(DimDate[Date],EndDate,-28,DAY))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "02 Time",
            "description": "28 calendar days inclusive of the selected end date.",
            "lineageTag": "ff45c784-10f4-5a30-94d2-f0c15d88f1e2"
          },
          {
            "name": "Rolling 13 Week Sales",
            "expression": "VAR EndDate = MAX(DimDate[Date]) RETURN CALCULATE([Revenue],DATESINPERIOD(DimDate[Date],EndDate,-91,DAY))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "02 Time",
            "description": "91 calendar days; periods near start of dataset are partial.",
            "lineageTag": "636072db-6a21-5f9a-921b-99311af9e5c2"
          },
          {
            "name": "Target Revenue",
            "expression": "SUM(FactTargets[TargetRevenue])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "03 Plan",
            "description": "Independent pre-period expectation; same product/customer/date grain as sales.",
            "lineageTag": "9606d7fc-928e-5809-bd86-be937e12b942"
          },
          {
            "name": "Revenue vs Target",
            "expression": "[Revenue]-[Target Revenue]",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "03 Plan",
            "description": "Absolute AUD gap.",
            "lineageTag": "e88ca6fa-588d-5e71-bf07-9f709116b6d0"
          },
          {
            "name": "Target Attainment %",
            "expression": "DIVIDE([Revenue],[Target Revenue])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "03 Plan",
            "description": "Ratios only within the same fact scope.",
            "lineageTag": "398ec6b5-509f-5d01-9648-2a147dc6b31a"
          },
          {
            "name": "Revenue Contribution %",
            "expression": "DIVIDE([Revenue],CALCULATE([Revenue],REMOVEFILTERS(DimProduct),REMOVEFILTERS(DimCategory)))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "04 Category",
            "description": "Contribution within selected date/channel/region/customer scope; removes product/category filters.",
            "lineageTag": "962cec5f-3a0b-502f-80a5-1e78e6e50ad2"
          },
          {
            "name": "Selected Product Contribution %",
            "expression": "DIVIDE([Revenue],CALCULATE([Revenue],ALLSELECTED(DimProduct)))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "04 Category",
            "description": "Share of products in current user selection; keeps category and other dimensions.",
            "lineageTag": "151d8620-790d-59f6-b111-ba8c0ed07297"
          },
          {
            "name": "Market Revenue",
            "expression": "IF(ISFILTERED(DimProduct) || ISFILTERED(DimCustomer),BLANK(),SUM(FactMarket[MarketRevenue]))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "04 Category",
            "description": "Synthetic market at date/category/channel/region grain. Blank under SKU or customer filters.",
            "lineageTag": "39884b53-42f8-5526-b05d-7271311d3bfd"
          },
          {
            "name": "Simulated Market Share %",
            "expression": "DIVIDE([Revenue],[Market Revenue])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "04 Category",
            "description": "Generated market dollars denominator; no factual CCEP market-share claim.",
            "lineageTag": "93334f74-9313-588c-893e-3b6d869a7bb8"
          },
          {
            "name": "Simulated Share LY",
            "expression": "CALCULATE([Simulated Market Share %],SAMEPERIODLASTYEAR(DimDate[Date]))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "04 Category",
            "description": "Matching calendar-year simulated share.",
            "lineageTag": "5cd817cd-835d-5e7a-8cc4-e97048b1cfb4"
          },
          {
            "name": "Share Change pp",
            "expression": "VAR CurrentShare=[Simulated Market Share %] VAR PriorShare=[Simulated Share LY] RETURN IF(HASONEVALUE(DimDate[Year])&&NOT ISBLANK(CurrentShare)&&NOT ISBLANK(PriorShare),100*(CurrentShare-PriorShare))",
            "formatString": "0.00 \"pp\"",
            "displayFolder": "04 Category",
            "description": "Percentage-point change; blank if either share is unavailable.",
            "lineageTag": "1176201c-dcee-5f6a-baa4-60a430cf38a8"
          },
          {
            "name": "Active Store Days",
            "expression": "SUM(FactDistribution[ActiveStoreDays])",
            "formatString": "#,0",
            "displayFolder": "05 Distribution",
            "description": "Additive SKU-store-days; not distinct physical stores.",
            "lineageTag": "e69a0899-e6bb-5520-8ae9-c01e0487bbb2"
          },
          {
            "name": "Eligible Store Days",
            "expression": "SUM(FactDistribution[EligibleStoreDays])",
            "formatString": "#,0",
            "displayFolder": "05 Distribution",
            "description": "Universe of eligible SKU-store-day opportunities.",
            "lineageTag": "03deb28a-d57a-5e68-809a-445e6c555ce4"
          },
          {
            "name": "Distribution %",
            "expression": "DIVIDE([Active Store Days],[Eligible Store Days])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "05 Distribution",
            "description": "Weighted distribution proxy. Does not estimate ACV distribution.",
            "lineageTag": "6ab40f5b-8a52-55f8-87d4-3616905ee8ba"
          },
          {
            "name": "Velocity",
            "expression": "DIVIDE([Units],[Active Store Days])",
            "formatString": "0.00",
            "displayFolder": "05 Distribution",
            "description": "Units per active SKU-store-day; preserves exposure when summing dates/SKUs.",
            "lineageTag": "9d9a8fbd-e3ac-5ca8-b4db-986e1baa079a"
          },
          {
            "name": "Revenue per Active Store Day",
            "expression": "DIVIDE([Revenue],[Active Store Days])",
            "formatString": "$0.00",
            "displayFolder": "05 Distribution",
            "description": "Revenue per active SKU-store-day.",
            "lineageTag": "2da94c61-a8a8-584f-a5fc-8c38035c94ac"
          },
          {
            "name": "SKU Revenue Rank",
            "expression": "RANKX(ALLSELECTED(DimProduct[Product]),[Revenue],,DESC,DENSE)",
            "formatString": "0",
            "displayFolder": "05 Distribution",
            "description": "Rank within selected product universe.",
            "lineageTag": "32fd5257-7acd-563d-bc28-1be65a1c910a"
          },
          {
            "name": "Trade Spend",
            "expression": "SUM(FactSales[TradeSpend])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "06 Promotion",
            "description": "Campaign execution spend; discounts are already inside net revenue.",
            "lineageTag": "e856890a-074c-5d74-9e75-8e86be9e0f04"
          },
          {
            "name": "Baseline Units",
            "expression": "SUM(FactPromotion[BaselineUnits])",
            "formatString": "#,0",
            "displayFolder": "06 Promotion",
            "description": "Generator counterfactual only for promoted product/customer/days.",
            "lineageTag": "e01519dd-41bd-5e00-b0b2-1d59f28a6678"
          },
          {
            "name": "Promoted Units",
            "expression": "SUM(FactPromotion[ActualUnits])",
            "formatString": "#,0",
            "displayFolder": "06 Promotion",
            "description": "Same promoted population as baseline.",
            "lineageTag": "a947fd32-f54c-59ef-b323-805767736d04"
          },
          {
            "name": "Incremental Units",
            "expression": "[Promoted Units]-[Baseline Units]",
            "formatString": "#,0",
            "displayFolder": "06 Promotion",
            "description": "Simulated incremental units, not real experimentally measured lift.",
            "lineageTag": "9f7745d4-08d1-5582-8ce8-3a561f49b980"
          },
          {
            "name": "Promotion Lift %",
            "expression": "DIVIDE([Incremental Units],[Baseline Units])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "06 Promotion",
            "description": "Counterfactual same-period simulated lift.",
            "lineageTag": "2c91e05d-98c4-52b8-b185-f1c2eba48061"
          },
          {
            "name": "Incremental Sales",
            "expression": "SUM(FactPromotion[ActualRevenue])-SUM(FactPromotion[BaselineRevenue])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "06 Promotion",
            "description": "Net revenue delta includes lower realised prices.",
            "lineageTag": "95c16852-5578-5985-bc28-368d1159a207"
          },
          {
            "name": "Net Incremental Promotion Profit",
            "expression": "SUM(FactPromotion[NetIncrementalProfit])",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "06 Promotion",
            "description": "Actual GP minus baseline GP minus trade spend; no double-counted discount expense.",
            "lineageTag": "091b9011-c418-5252-b1a8-87d12d8ff082"
          },
          {
            "name": "Promotion ROI",
            "expression": "DIVIDE([Net Incremental Promotion Profit],SUM(FactPromotion[TradeSpend]))",
            "formatString": "0.00\"x\"",
            "displayFolder": "06 Promotion",
            "description": "Net incremental profit per AUD of execution spend; can be negative.",
            "lineageTag": "0eaff288-a2d8-51e0-b62e-ac8ae3a0c92c"
          },
          {
            "name": "Discount Depth %",
            "expression": "DIVIDE(SUMX(FactPromotion,FactPromotion[DiscountDepth]*FactPromotion[ActualUnits]),[Promoted Units])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "06 Promotion",
            "description": "Unit-weighted discount depth for promoted observations only.",
            "lineageTag": "b02c3d74-2bfb-5ee4-b5fd-fe3508cadb73"
          },
          {
            "name": "Innovation Revenue",
            "expression": "CALCULATE([Revenue],KEEPFILTERS(DimProduct[Innovation]=1))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "07 Innovation",
            "description": "Sales from the two simulated 2024 launches.",
            "lineageTag": "7a0c36a0-7b75-5c31-a061-aeaa3f14b236"
          },
          {
            "name": "Innovation Contribution %",
            "expression": "DIVIDE([Innovation Revenue],[Revenue])",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "07 Innovation",
            "description": "Launch revenue share of selected revenue.",
            "lineageTag": "84d53240-2460-5e76-9b33-ddd340847e0b"
          },
          {
            "name": "Cohort Repeat Rate %",
            "expression": "DIVIDE(SUM(FactInnovationPanel[RepeatWithin28d]),SUM(FactInnovationPanel[Trials]))",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "07 Innovation",
            "description": "Trials-weighted 28-day repeat; cohorts with incomplete follow-up excluded in ETL.",
            "lineageTag": "225cf369-3f9f-5b96-aa43-ee5c1873c9b8"
          },
          {
            "name": "Distribution Opportunity Revenue",
            "expression": "VAR CurrentDist=[Distribution %] VAR DesiredDist=SELECTEDVALUE(DistributionGoal[Value],0.70) RETURN IF(CurrentDist>0,[Revenue]*MAX(0,DesiredDist-CurrentDist)/CurrentDist)",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "08 Scenarios",
            "description": "SIMULATION: same velocity, price and period, incremental distribution only; no cannibalisation or costs.",
            "lineageTag": "8e29f8e8-2b52-534e-b48d-59dcba984e51"
          },
          {
            "name": "Selected KPI",
            "expression": "SWITCH(SELECTEDVALUE(KPISelector[KPI],\"Revenue\"),\"Revenue\",[Revenue],\"Gross margin\",[Gross Margin %],\"Velocity\",[Velocity],\"Target attainment\",[Target Attainment %])",
            "formatString": "#,0.0",
            "displayFolder": "08 Scenarios",
            "description": "Disconnected KPI selector; dynamic format keeps money, percentages and exposure distinct.",
            "formatStringDefinition": {
              "expression": "SWITCH(SELECTEDVALUE(KPISelector[KPI],\"Revenue\"),\"Revenue\",\"$#,0\",\"Gross margin\",\"0.0%\",\"Velocity\",\"0.00\",\"Target attainment\",\"0.0%\")"
            },
            "lineageTag": "7ae3b6ed-8141-5754-9242-4e83ef95ae46"
          },
          {
            "name": "Dynamic Title",
            "expression": "\"SYNTHETIC | \" & SELECTEDVALUE(KPISelector[KPI],\"Revenue\") & \" | \" & IF(HASONEVALUE(DimCategory[Category]),SELECTEDVALUE(DimCategory[Category]),\"Selected categories\")",
            "formatString": "@",
            "displayFolder": "08 Scenarios",
            "description": "Title always retains synthetic status.",
            "lineageTag": "d96500d7-0062-554d-90b9-e0756b428b54"
          },
          {
            "name": "Variance Colour",
            "expression": "IF([Revenue vs Target]<0,\"#BA3548\",\"#087F70\")",
            "formatString": "@",
            "displayFolder": "08 Scenarios",
            "description": "Used by conditional formatting for a plan gap; does not encode a causal claim.",
            "lineageTag": "9cd2c18c-b500-50bc-ac45-406f3ceedb08"
          }
        ],
        "lineageTag": "041d1255-6a33-5cb0-a33a-f23dc25a7f39"
      },
